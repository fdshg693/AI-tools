# pwdo の .env 記入例。読むのはこのファイルと同じ階層（tools/browser/pwdo/.env）の 1 か所だけ。
# 親ディレクトリやリポジトリルートの .env は探さない。プロセス環境変数があればそちらが優先。
# pwq とは別ファイル（鍵を共有したいときはプロセス環境変数で渡す）。
#
#   cp .env.example .env    # 値を埋めてから `pwdo models` で鍵の解決を確認する

# [必須] OpenRouter API キー。pwdo は LLM が無いと 1 ステップも進めないので、無ければ failed で止まる。
OPENROUTER_API_KEY=

# [任意] 互換エンドポイントを使うときだけ。既定: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=

# [任意] -s=<session> を省略したときのセッション名（playwright-cli と共通）。
# PLAYWRIGHT_CLI_SESSION=

# [任意] pwq の実体（dist/cli.js）のパス。未設定なら PATH の pwq → 隣の ../pwq/dist/cli.js の順に探す。
# PWDO_PWQ=

# [任意] playwright-cli の実体のパス。未設定なら PATH から探す。
# PWDO_PLAYWRIGHT_CLI=
