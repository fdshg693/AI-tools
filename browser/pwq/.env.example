# pwq の .env 記入例。読むのはこのファイルと同じ階層（tools/browser/pwq/.env）の 1 か所だけ。
# 親ディレクトリやリポジトリルートの .env は探さない。プロセス環境変数があればそちらが優先。
#
#   cp .env.example .env    # 値を埋めてから `pwq models` で鍵の解決を確認する

# [任意] OpenRouter API キー。explore / ask / summarize / --pwq-summarize だけが使う。
# 無ければ LLM 層だけをスキップし、決定論的ダイジェストは通常どおり出る。
OPENROUTER_API_KEY=

# [任意] 互換エンドポイントを使うときだけ。既定: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=

# [任意] -s=<session> を省略したときのセッション名（playwright-cli と共通）。既定: default
# PLAYWRIGHT_CLI_SESSION=

# [任意] playwright-cli の実体（playwright-cli.js 等）のパス。未設定なら PATH から探す。
# PWQ_PLAYWRIGHT_CLI=
