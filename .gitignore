# Repository-level ignores. Kept in sync by hand with the umbrella's .gitignore
# (fdshg693/AI); the umbrella's rules do not apply inside a submodule.

# env / secrets
*.env
.env
*.pem

# dependencies / build
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
node_modules/
*.egg-info/
.DS_Store

# local notes / scratch / logs
memo/
temp/
logs/
*.log
# skill-tools feedback (`--fb`)
fb/

# caches and local databases
.cache/
*.sqlite3
.codegraph/
.textgraph/

# this repository
sandbox/orchestrator/data/

# Claude Code: hooks installed by `just sub-agent-hooks-install` and local settings (generated)
.claude/settings.json
.claude/settings.local.json
.claude/hooks/
.claude/tasks/
.skill-tools/

# Links created by `just links-sync` from .links.yaml (never committed). info/exclude lists them
# with a trailing "/", which matches Windows junctions but not macOS/Linux symlinks.
/_umbrella/
/.claude/skills/committing
/.claude/skills/changing-skills-and-tools
/.claude/skills/meta
/.claude/skills/writing-skill
